---
/**
 * Menu numerado em pílula (design 11.4): <nav id="capitulos"> sob o palco. Só existe no modo quarto (CSS), a partir de 768 px.
 * Com uma vista aberta, o JS move este <nav> para o <dialog> (uma única instância).
 */
import CapitulosLista from './CapitulosLista.astro';
import { getTextos } from '../../lib/textos';
import type { Idioma } from '../../i18n/idiomas';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const t = getTextos(lang);
---

<div class="capitulos-slot">
  <nav id="capitulos" class="capitulos" aria-label={t.menu.rotulo}>
    <CapitulosLista lang={lang} classe="cap-lista" />
  </nav>
</div>
