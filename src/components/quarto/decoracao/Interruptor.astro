---
/** Decoração "Interruptor" (não clicável; SVG flat, classes f-* = var(--room-*)), em coordenadas locais. Posição: src/config/quarto.ts. */
import type { PropsDesenho } from '../props';

export type Props = PropsDesenho;
---

<g data-desenho="Interruptor">
  <rect class="f-wall-shade" x="0" y="0" width="16" height="28" rx="3"></rect>
  <rect class="f-metal dia" x="4" y="4" width="8" height="10" rx="2"></rect>
  <rect class="f-metal noite" x="4" y="14" width="8" height="10" rx="2"></rect>
</g>
