---
/** Decoração "Cadeira" (não clicável; SVG flat, classes f-* = var(--room-*)), em coordenadas locais. Posição: src/config/quarto.ts. */
import type { PropsDesenho } from '../props';

export type Props = PropsDesenho;
---

<g data-desenho="Cadeira">
  <rect class="f-fabric" x="30" y="0" width="100" height="120" rx="16"></rect>
  <rect class="f-fabric" x="10" y="130" width="140" height="26" rx="10"></rect>
  <rect class="f-metal" x="72" y="156" width="16" height="70"></rect>
  <rect class="f-metal" x="24" y="224" width="112" height="12" rx="5"></rect>
  <circle class="f-metal" cx="30" cy="248" r="10"></circle>
  <circle class="f-metal" cx="80" cy="248" r="10"></circle>
  <circle class="f-metal" cx="130" cy="248" r="10"></circle>
</g>
