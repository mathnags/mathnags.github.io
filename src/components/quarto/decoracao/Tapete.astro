---
/** Decoração "Tapete" (não clicável; SVG flat, classes f-* = var(--room-*)), em coordenadas locais. Posição: src/config/quarto.ts. */
import type { PropsDesenho } from '../props';

export type Props = PropsDesenho;
---

<g data-desenho="Tapete">
  <rect class="f-fabric" x="0" y="0" width="500" height="60" rx="12"></rect>
  <rect class="f-wall-shade" x="16" y="12" width="468" height="6"></rect>
  <rect class="f-wall-shade" x="16" y="42" width="468" height="6"></rect>
</g>
