  <rect class="f-wood-dark" x="472" y="34" width="18" height="286"></rect>
  <rect class="f-wood-dark" x="20" y="22" width="480" height="18" rx="2"></rect>
  <rect class="f-wood" x="330" y="42" width="120" height="64" rx="5"></rect>
  <rect class="f-metal" x="382" y="68" width="16" height="6" rx="3"></rect>
