---
/** Desenho de "Quadros" (SVG flat, só preenchimentos e classes f-* = var(--room-*)), em coordenadas locais. Posição e vista: src/config/quarto.ts. */
import type { PropsDesenho } from '../props';

export type Props = PropsDesenho;
const molduras = [
  { x: 0, y: 0 },
  { x: 120, y: 0 },
  { x: 60, y: 100 },
];
---

<g data-desenho="Quadros">
  {
    molduras.map((m) => (
      <>
        <path class="f-side" d={`M${m.x} ${m.y}L${m.x - 6} ${m.y + 6}V${m.y + 76}L${m.x} ${m.y + 82}z`} />
        <rect class="f-wood-dark" x={m.x} y={m.y} width="100" height="82" rx="4" />
        <rect class="f-paper" x={m.x + 7} y={m.y + 7} width="86" height="68" rx="2" />
        <rect class="f-wall-shade" x={m.x + 18} y={m.y + 20} width="64" height="5" />
        <rect class="f-wall-shade" x={m.x + 18} y={m.y + 32} width="48" height="5" />
        <circle class="f-bon" cx={m.x + 70} cy={m.y + 56} r="8" />
      </>
    ))
  }
</g>
