---
/** Desenho de "Estante" (SVG flat, só preenchimentos e classes f-* = var(--room-*)), em coordenadas locais. Posição e vista: src/config/quarto.ts. */
import type { PropsDesenho } from '../props';

export type Props = PropsDesenho;
// Livros em pé: [largura, altura, cor]. Geometria local da estante.
const cores = ['f-fabric', 'f-red', 'f-blue', 'f-wood', 'f-paper', 'f-cork', 'f-metal'] as const;
const larguras = [14, 10, 16, 12, 18, 10, 14, 12, 16, 10];
const alturas = [70, 82, 64, 76, 88, 68, 80, 72, 62, 78];
const prateleiras = [0, 1, 2].map((p) => {
  let x = 18;
  const livros: { x: number; y: number; l: number; a: number; c: string }[] = [];
  for (let i = 0; x < 200; i++) {
    const k = (i + p * 3) % larguras.length;
    const l = larguras[k];
    if (x + l > 224) break;
    const a = alturas[k] - 6 * (p === 2 ? 1 : 0);
    livros.push({ x, y: 15 + p * 103 + 95 - a, l, a, c: cores[(i * 2 + p) % cores.length] });
    x += l + 2;
  }
  return livros;
});
---

<g data-desenho="Estante">
  <path class="f-top" d="M0 0L-12 -14H228L240 0z"></path>
  <path class="f-side" d="M0 0L-12 -14V326L0 340z"></path>
  <rect class="f-wood" x="0" y="0" width="240" height="340" rx="8"></rect>
  <rect class="f-wood-dark" x="12" y="15" width="216" height="310"></rect>
  {prateleiras.flat().map((b) => <rect class={b.c} x={b.x} y={b.y} width={b.l} height={b.a} rx="2" />)}
  <rect class="f-wood" x="12" y="110" width="216" height="8"></rect>
  <rect class="f-wood" x="12" y="213" width="216" height="8"></rect>
  <rect class="f-wood" x="12" y="316" width="216" height="9"></rect>
</g>
