---
/** Desenho de "Envelope" (SVG flat, só preenchimentos e classes f-* = var(--room-*)), em coordenadas locais. Posição e vista: src/config/quarto.ts. */
import type { PropsDesenho } from '../props';

export type Props = PropsDesenho;
---

<g data-desenho="Envelope">
  <rect class="f-paper" x="0" y="0" width="100" height="80" rx="6"></rect>
  <path class="f-wall-shade" d="M0 6a6 6 0 0 1 6-6h88a6 6 0 0 1 6 6L50 46z"></path>
  <path class="f-wall-shade" d="M0 80L40 40 50 48 60 40 100 80z" opacity=".6"></path>
  <rect class="f-fabric" x="72" y="52" width="20" height="20" rx="3"></rect>
  <circle class="f-bon" cx="50" cy="46" r="6"></circle>
</g>
