---
/** Desenho de "Mural" (SVG flat, só preenchimentos e classes f-* = var(--room-*)), em coordenadas locais. Posição e vista: src/config/quarto.ts. */
import type { PropsDesenho } from '../props';

export type Props = PropsDesenho;
---

<g data-desenho="Mural">
  <rect class="f-wood" x="0" y="0" width="240" height="210" rx="10"></rect>
  <rect class="f-cork" x="12" y="12" width="216" height="186" rx="4"></rect>
  <g transform="rotate(-2 62 50)"><rect class="f-paper" x="26" y="28" width="72" height="58" rx="2"></rect><rect class="f-wall-shade" x="34" y="44" width="48" height="5"></rect><rect class="f-wall-shade" x="34" y="56" width="56" height="5"></rect><rect class="f-wall-shade" x="34" y="68" width="38" height="5"></rect><circle class="f-bon" cx="62" cy="31" r="5"></circle></g>
  <g transform="rotate(2 148 48)"><rect class="f-paper" x="116" y="26" width="64" height="52" rx="2"></rect><rect class="f-wall-shade" x="124" y="42" width="44" height="5"></rect><rect class="f-wall-shade" x="124" y="54" width="32" height="5"></rect><circle class="f-bon" cx="148" cy="29" r="5"></circle></g>
  <g transform="rotate(-1 200 60)"><rect class="f-paper" x="190" y="30" width="30" height="60" rx="2"></rect><rect class="f-wall-shade" x="195" y="46" width="20" height="5"></rect><circle class="f-bon" cx="205" cy="33" r="5"></circle></g>
  <g transform="rotate(1.5 70 140)"><rect class="f-paper" x="26" y="104" width="86" height="72" rx="2"></rect><rect class="f-wall-shade" x="34" y="122" width="62" height="5"></rect><rect class="f-wall-shade" x="34" y="134" width="70" height="5"></rect><rect class="f-wall-shade" x="34" y="146" width="44" height="5"></rect><circle class="f-bon" cx="69" cy="107" r="5"></circle></g>
  <g transform="rotate(-2 170 140)"><rect class="f-paper" x="128" y="108" width="84" height="66" rx="2"></rect><rect class="f-wall-shade" x="136" y="126" width="60" height="5"></rect><rect class="f-wall-shade" x="136" y="138" width="68" height="5"></rect><rect class="f-wall-shade" x="136" y="150" width="40" height="5"></rect><circle class="f-bon" cx="170" cy="111" r="5"></circle></g>
</g>
