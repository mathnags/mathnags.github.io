---
/** Desenho de "Estojos" (SVG flat, só preenchimentos e classes f-* = var(--room-*)), em coordenadas locais. Posição e vista: src/config/quarto.ts. */
import type { PropsDesenho } from '../props';

export type Props = PropsDesenho;
const { lombadas = [] } = Astro.props;
// Pilha deitada de até 5 estojos; deslocamentos fixos para parecer uma pilha.
const desl = [6, 0, 10, 2, 8];
---

<g data-desenho="Estojos">
  <!-- Controle genérico (osso): 2 analógicos e 4 pontos lisos, sem símbolos de botão -->
  <circle class="f-metal" cx="82" cy="12" r="12"></circle>
  <circle class="f-metal" cx="178" cy="12" r="12"></circle>
  <rect class="f-metal" x="82" y="2" width="96" height="22" rx="9"></rect>
  <circle class="f-fabric" cx="88" cy="12" r="5"></circle>
  <circle class="f-fabric" cx="172" cy="12" r="5"></circle>
  <circle class="f-fabric" cx="124" cy="8" r="3"></circle>
  <circle class="f-fabric" cx="136" cy="8" r="3"></circle>
  <circle class="f-fabric" cx="124" cy="17" r="3"></circle>
  <circle class="f-fabric" cx="136" cy="17" r="3"></circle>
  {
    lombadas.slice(0, 5).map((nome, i) => (
      <>
        <rect class="f-paper" x={desl[i]} y={26 + i * 19} width="244" height="18" rx="3" />
        <rect class="f-wall-shade" x={desl[i]} y={26 + i * 19} width="8" height="18" rx="3" />
        <text class="lombada" x={desl[i] + 16} y={26 + i * 19 + 13}>{nome}</text>
      </>
    ))
  }
  <path class="f-side" d="M0 130L12 140H248L260 130z"></path>
  <rect class="f-wood" x="0" y="122" width="260" height="8" rx="2"></rect>
</g>
