---
/**
 * O quarto 3D (design 13). O palco leva um <canvas> decorativo (aria-hidden) onde a cena Three.js aparece depois do load; o texto é
 * sempre HTML real: o nome na parede (bloco que vira um CSS3DObject), os links dos objetos (<a class="objeto">, invisíveis, projetados de frente para a
 * tela), as anotações, a intro, o tour pela rolagem (cartões no fluxo) e, no mobile sem 3D, os nichos só de texto. Tudo sai de
 * src/config/quarto.ts e de textos.<lang>.json; nada de texto ou coordenada fixa aqui. Visível só com data-modo="quarto".
 */
import Icone from '../ui/Icone.astro';
import { objetosEmOrdem, quarto } from '../../config/quarto';
import { numeroDoCapitulo } from '../../i18n/secoes';
import { getTextos } from '../../lib/textos';
import { getUi } from '../../lib/ui';
import type { Idioma } from '../../i18n/idiomas';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const t = getTextos(lang);
const ui = getUi(lang);

/* ---- Objetos, tour e nichos ---- */
const itens = objetosEmOrdem.map((o) => ({
  o,
  txt: t.quarto.objetos[o.id],
  num: numeroDoCapitulo(o.capitulo),
  resumo: t.tour[o.destino as keyof typeof t.tour] as { resumo: string },
}));
const progresso = (n: string) => t.tour.progresso.replace('{n}', n);

const PALAVRAS_SQL = /\b(SELECT|FROM|WHERE|AND|BETWEEN|ORDER BY)\b/g;
const trechosSql = (linha: string) => {
  const partes: { txt: string; kw: boolean }[] = [];
  let fim = 0;
  for (const m of linha.matchAll(PALAVRAS_SQL)) {
    if (m.index > fim) partes.push({ txt: linha.slice(fim, m.index), kw: false });
    partes.push({ txt: m[0], kw: true });
    fim = m.index + m[0].length;
  }
  if (fim < linha.length) partes.push({ txt: linha.slice(fim), kw: false });
  return partes;
};
const [anotComece, anotRole] = quarto.anotacoes;
---

<nav id="quarto" aria-label={t.quarto.titulo} data-passo="0">
  <p class="sr-only">{t.quarto.cenaDescricao}</p>
  <p class="sr-only">{t.quarto.ajuda}</p>

  <div class="palco" data-estado="repouso" data-passo="0">
    <!-- Mobile sem 3D: a assinatura (a carreira que dobra em 2026 rumo a IA) em grande atrás do nome. -->
    <svg class="heroi-linha" viewBox="0 0 200 80" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
      <path d="M8 62H64L94 62" fill="none" stroke="var(--text-muted)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" opacity="0.55"></path>
      <path d="M94 62L126 22H192" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path>
      <circle cx="192" cy="22" r="5" fill="none" stroke="var(--pine)" stroke-width="2"></circle>
    </svg>
    <canvas class="cena" aria-hidden="true"></canvas>

    <div class="parede-bloco">
      <p class="parede" aria-hidden="true">
        <span class="parede-nome">{t.hero.nome}</span>
      </p>
      <a class="postit-contato" href={t.contato.linkedinUrl} target="_blank" rel="noopener noreferrer">
        <span class="pc-titulo">{t.postit.contato.titulo}</span>
        <span class="pc-cta">{t.postit.contato.cta}<Icone nome="externo" tamanho={12} /><span class="sr-only">{ui.linkExterno}</span></span>
      </a>
      <a class="explorar" href="#nichos">{t.quarto.explorarAbaixo}<Icone nome="seta" tamanho={16} class="seta-baixo" /></a>
    </div>

    <ol class="objetos">
      {
        itens.map(({ o, txt, num }) => (
          <li>
            <a class="objeto" href={`#${o.destino}`} data-objeto={o.id} data-cap={o.capitulo}>
              <span class="p-num">{num}</span>
              <span class="sr-only"> · {txt.tema}, </span>
              <span class="p-nome">{txt.comum}</span><span class="sr-only estado" data-lido={t.quarto.estado.lido} data-proximo={t.quarto.estado.proximo}></span>
            </a>
          </li>
        ))
      }
    </ol>

    <div class="anotacoes" aria-hidden="true">
      <svg class="setas" focusable="false">
        <path class="seta-halo" pathLength="1" data-seta="0"></path>
        <path class="seta-traco" pathLength="1" data-seta="0"></path>
        <path class="seta-halo" pathLength="1" data-seta="1"></path>
        <path class="seta-traco" pathLength="1" data-seta="1"></path>
      </svg>
      <p class="anot" data-anot="comece" style={`--arot:${anotComece.rot}deg;--amax:${anotComece.larguraMax}px`}>{t.anotacoes.comece}</p>
      <p
        class="anot"
        data-anot="role"
        style={`--ax:${anotRole.id === 'role' ? anotRole.tela.x : '50%'};--abase:${anotRole.id === 'role' ? anotRole.tela.base : 96}px;--arot:${anotRole.rot}deg;--amax:${anotRole.larguraMax}px`}
      >
        {t.anotacoes.role}
      </p>
    </div>

    <!-- Enquanto a cena carrega (visitas seguintes à intro): pílula de status com barra indeterminada. -->
    <div class="carregando" role="status" data-texto={t.quarto.carregando}>
      <span class="carregando-txt"></span>
      <span class="carregando-barra" aria-hidden="true"></span>
    </div>

    <!-- Falha ao carregar a cena: não há troca automática de modo, para evitar salto de layout e surpresa. -->
    <div class="erro-cena papel" hidden>
      <p>{t.quarto.erroCena}</p>
      <div class="erro-cena-acoes">
        <button class="cta cta-primario" type="button" data-cena-tentar>{t.quarto.tentarDeNovo}</button>
        <button class="cta" type="button" data-cena-recrutador>{t.topo.modoRecrutador}</button>
      </div>
    </div>

    <div class="intro" data-intro-overlay>
      <div class="intro-cartao">
        <div aria-hidden="true">
          {
            t.intro.linhas.map((l, i) => (
              <p class:list={['intro-linha', l.startsWith('--') && 'intro-comentario']} style={`--n:${i}`}>
                {l.startsWith('--') ? l : trechosSql(l).map((p) => (p.kw ? <span class="kw">{p.txt}</span> : p.txt))}
              </p>
            ))
          }
          <div class="intro-exec">
            <span class="intro-trilho"></span><span class="intro-exec-txt">{t.intro.executando}</span>
          </div>
          <p class="intro-resultado">&#10003; {t.intro.resultado}</p>
        </div>
        <button class="intro-pular" type="button" aria-label={t.intro.pularRotulo} data-intro-pular>{t.intro.pular}</button>
      </div>
    </div>

    <div class="trilho" aria-hidden="true">
      {itens.map(({ num }) => <span class="traco" data-n={num}>{num}</span>)}
      <span class="traco traco-monitor"><Icone nome="menu" tamanho={14} /></span>
    </div>
    <div class="tour-acoes">
      <button class="tour-sair" type="button" data-tour-sair><Icone nome="seta" class="seta-cima" />{t.tour.sair}</button>
      <button class="tour-ir" type="button" data-tour-monitor><Icone nome="seta" class="seta-baixo" />{t.tour.irMonitor}</button>
    </div>

    <div class="so-tour" data-vista="tela" hidden></div>
  </div>

  <ol class="tour">
    <li class="passo passo-vazio" data-passo="0" aria-hidden="true"></li>
    {
      itens.map(({ o, txt, num, resumo }, i) => (
        <li class="passo" data-passo={i + 1} data-lado={o.tour.lado}>
          <div class="cartao papel">
            <p class="cartao-titulo">
              <span class="cartao-prog">{progresso(num)}</span>
              <span class="cartao-nome">{txt.tema} · {txt.comum}</span>
            </p>
            <p class="cartao-texto">{resumo.resumo}</p>
            {i === 0 && <p class="cartao-fim">{t.tour.vertice.fim}</p>}
            <a class="cta cta-primario tour-abrir" href={`#${o.destino}`} data-objeto={o.id} data-cap={o.capitulo}>
              <span>{t.tour.abrir}</span><span class="sr-only">: {txt.comum}</span>
            </a>
          </div>
        </li>
      ))
    }
    <li class="passo passo-vazio" data-passo="9" aria-hidden="true"></li>
  </ol>

  <ol class="nichos" id="nichos">
    {
      itens.map(({ o, txt, num, resumo }) => (
        <li>
          <a class="nicho" href={`#${o.destino}`} data-objeto={o.id} data-cap={o.capitulo}>
            <span class="postit">
              <span class="p-num">{num}</span>
              <span class="sr-only"> · {txt.tema}, </span>
              <span class="p-nome">{txt.comum}</span>
              <Icone nome="check" tamanho={14} class="p-check" />
              <span class="sr-only estado" data-lido={t.quarto.estado.lido} data-proximo={t.quarto.estado.proximo}></span>
            </span>
            <span class="nicho-texto">
              <span class="nicho-tema">{txt.tema}</span>
              <span class="nicho-resumo">{resumo.resumo}</span>
              <span class="nicho-acao" aria-hidden="true">{t.tour.abrir}<Icone nome="seta" /></span>
            </span>
          </a>
        </li>
      ))
    }
  </ol>
</nav>
