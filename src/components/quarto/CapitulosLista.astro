---
/** Os 8 capítulos como links numerados (design 11.4). Usada na pílula (desktop) e na lista do mobile (popover). */
import { SECOES, numeroDoCapitulo } from '../../i18n/secoes';
import { getTextos } from '../../lib/textos';
import type { Idioma } from '../../i18n/idiomas';

interface Props {
  lang: Idioma;
  classe: string;
}
const { lang, classe } = Astro.props;
const t = getTextos(lang);
const capitulos = SECOES.flatMap((s) => (s.capitulo ? [{ id: s.id, cap: s.capitulo, nome: t.menu.itens[s.id as keyof typeof t.menu.itens] }] : []));
---

<ol class={classe}>
  {
    capitulos.map((c) => (
      <li>
        <a class="cap-item" href={`#${c.id}`} data-cap={c.cap} data-cap-link>
          <span class="num">{numeroDoCapitulo(c.cap)}</span>{' '}<span class="nome">{c.nome}</span>
        </a>
      </li>
    ))
  }
</ol>
