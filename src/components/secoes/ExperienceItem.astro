---
/** Item de experiência: papel no mural (vista cortica) e linha do tempo no modo recrutador (design 5.12). */
import type { Textos } from '../../schemas/conteudo';

interface Props {
  item: Textos['experiencia']['itens'][number];
  rotuloAprendizado: string;
}
const { item, rotuloAprendizado } = Astro.props;
---

<li class="exp" id={item.id}>
  <span class="tachinha" aria-hidden="true"></span>
  <div class="exp-cargos">
    {
      item.cargos.map((c) => (
        <p class="exp-cargo">
          <span class="cargo-nome">{c.titulo}</span>
          <time datetime={c.inicio}>{c.periodo}</time>
        </p>
      ))
    }
  </div>
  <div class="exp-corpo">
    <h3>{item.empresa}</h3>
    <p class="exp-meta">{item.area} · {item.local}</p>
    <ul class="lista">{item.bullets.map((b) => <li>{b}</li>)}</ul>
    {
      item.aprendizado && (
        <p class="aprendizado">
          <strong>{rotuloAprendizado}:</strong> {item.aprendizado}
        </p>
      )
    }
  </div>
</li>
