---
/** Rodapé (design 4.7): copyright, GitHub em texto e o seletor de idioma. */
import { getRelativeLocaleUrl } from 'astro:i18n';
import Icone from '../ui/Icone.astro';
import { getTextos } from '../../lib/textos';
import { getUi } from '../../lib/ui';
import { CONFIG_IDIOMA, IDIOMAS, type Idioma } from '../../i18n/idiomas';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const t = getTextos(lang);
const ui = getUi(lang);
---

<footer class="rodape">
  <div class="rodape-in">
    <p>{t.rodape.copyright}</p>
    <a href={t.rodape.githubUrl}>{t.rodape.githubLabel}<Icone nome="externo" /><span class="sr-only">{ui.linkExterno}</span></a>
    <div class="idioma" role="group" aria-label={t.topo.idioma.rotulo}>
      {
        IDIOMAS.map((l) => (
          <a
            href={getRelativeLocaleUrl(l)}
            hreflang={CONFIG_IDIOMA[l].hreflang}
            lang={CONFIG_IDIOMA[l].htmlLang}
            aria-label={`${l.toUpperCase()}, ${t.topo.idioma[l]}`}
            aria-current={l === lang ? 'true' : undefined}
            data-idioma
          >
            {l.toUpperCase()}
          </a>
        ))
      }
    </div>
  </div>
</footer>
