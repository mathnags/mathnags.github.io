---
/** #ficha: resumo (design 4.5). No quarto vive na vista do porta-retrato (12.7), com h3 "Resumo". Nenhum número, nível ou barra. */
import Selo from '../ui/Selo.astro';
import BotaoCTA from '../ui/BotaoCTA.astro';
import { getTextos } from '../../lib/textos';
import { getUi } from '../../lib/ui';
import type { Idioma } from '../../i18n/idiomas';

interface Props {
  lang: Idioma;
}
const { lang } = Astro.props;
const t = getTextos(lang);
const ui = getUi(lang);
---

<section id="ficha" class="ficha" aria-labelledby="ficha-titulo">
  <h2 id="ficha-titulo" class="sr-only ficha-h2">{t.ficha.titulo}</h2>
  <h3 class="ficha-h3">{t.ficha.tituloNaVista}</h3>
  <div class="ficha-in">
    <div class="ficha-col">
    <div class="ficha-topo">
      <ul class="selos" aria-label={ui.selosStatus}>
        <Selo variante="transicao" texto={t.resumo.transicao} />
      </ul>
    </div>
    <p class="frase">{t.hero.frase}</p>
    <div class="ficha-acoes">
      <BotaoCTA lang={lang} href={t.contato.linkedinUrl} texto={t.hero.cta} externo />
      <a class="so-recrutador link-vertice" href="#vertice">{t.hero.ctaSecundario}</a>
    </div>
    </div>
    <div class="ficha-col">
    <dl class="dados">
      {
        t.hero.dados.map((d) => (
          <div class={`dado dado-${d.id}`}>
            <dt>{d.rotulo}</dt>
            <dd>{d.valor}</dd>
          </div>
        ))
      }
    </dl>
    <ul class="provas">
      {t.hero.provas.map((p) => <li>{p}</li>)}
    </ul>
    </div>
  </div>
</section>
